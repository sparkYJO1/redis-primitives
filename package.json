{
  "name": "redis-primitives",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed lock with fencing tokens, sliding-window rate limiter, and leader election on a single Redis instance. Tests demonstrate the failure modes.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "redis:up": "docker compose up -d --wait",
    "redis:down": "docker compose down -v",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "experiment:watch-multi": "tsx experiments/watch-multi-race.ts"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "author": "John Yoon"
}
